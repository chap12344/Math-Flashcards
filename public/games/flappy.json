{
  "id": "flappy",
  "title": "Retro Flappy",
  "description": "Flap through random, colorful pixel-art pipes in this fast-paced arcade velocity game.",
  "category": "Action",
  "icon": "Bird",
  "useBlankMath": true,
  "iframeUrl": "about:blank",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Retro Flappy</title>\n  <style>\n    body {\n      margin: 0;\n      background: #090d16;\n      color: #a855f7;\n      font-family: 'Courier New', Courier, monospace;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      overflow: hidden;\n      user-select: none;\n    }\n    #game-container {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      max-width: 100%;\n    }\n    canvas {\n      background: #020617;\n      border: 3px solid #a855f7;\n      box-shadow: 0 0 25px rgba(168, 85, 247, 0.35);\n      border-radius: 8px;\n      max-width: 90vw;\n      max-height: 55vh;\n      aspect-ratio: 0.75;\n    }\n    #ui {\n      display: flex;\n      justify-content: space-between;\n      width: 320px;\n      max-width: 90vw;\n      margin-bottom: 12px;\n      font-size: 18px;\n      font-weight: bold;\n      letter-spacing: 1px;\n    }\n    #overlay {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(15, 23, 42, 0.9);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      border-radius: 8px;\n      text-align: center;\n    }\n    .btn {\n      background: #1e293b;\n      border: 2px solid #a855f7;\n      color: #a855f7;\n      padding: 12px 28px;\n      font-weight: bold;\n      font-size: 16px;\n      cursor: pointer;\n      border-radius: 6px;\n      font-family: monospace;\n      letter-spacing: 2px;\n      margin-top: 15px;\n      transition: transform 0.1s;\n    }\n    .btn:active {\n      transform: scale(0.95);\n    }\n    #info-text {\n      color: #64748b;\n      font-size: 11px;\n      margin: 5px 0 20px 0;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <div id=\"ui\">\n      <div>SCORE: <span id=\"score\">0</span></div>\n      <div>HIGH: <span id=\"high\">0</span></div>\n    </div>\n    <canvas id=\"game\" width=\"320\" height=\"420\"></canvas>\n    \n    <div id=\"overlay\">\n      <h2 id=\"state-title\" style=\"color: #a855f7; margin: 0; font-size: 26px;\">RETRO FLAPPY</h2>\n      <p id=\"info-text\">TAP, CLICK, OR SPACEBAR TO FLAP BIRD</p>\n      <button class=\"btn\" id=\"action-btn\" onclick=\"start()\">START PLAYING</button>\n    </div>\n  </div>\n\n  <script>\n    let audioCtx = null;\n    function playTone(freq, duration, type = 'sine') {\n      try {\n        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        if (audioCtx.state === 'suspended') audioCtx.resume();\n        let osc = audioCtx.createOscillator();\n        let gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n        osc.type = type;\n        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n        osc.start();\n        osc.stop(audioCtx.currentTime + duration);\n      } catch(e){}\n    }\n\n    const canvas = document.getElementById('game');\n    const ctx = canvas.getContext('2d');\n    const scoreLabel = document.getElementById('score');\n    const highLabel = document.getElementById('high');\n    const overlay = document.getElementById('overlay');\n    const stateTitle = document.getElementById('state-title');\n    const actionBtn = document.getElementById('action-btn');\n\n    // Game variables\n    let bird = { x: 80, y: 150, r: 10, velocity: 0, gravity: 0.35, jump: -5.8 };\n    let pipes = [];\n    let score = 0;\n    let highScore = localStorage.getItem('flappy_high') || 0;\n    highLabel.textContent = highScore;\n    let gameRunning = false;\n    let pipeSpawnInterval = 100;\n    let frameCount = 0;\n\n    function flap() {\n      if (!gameRunning) return;\n      bird.velocity = bird.jump;\n      playTone(550, 0.08, 'sine');\n    }\n\n    // Spacebar listener\n    window.addEventListener('keydown', e => {\n      if (e.code === 'Space' || e.key === 'ArrowUp') {\n        flap();\n        e.preventDefault();\n      }\n    });\n\n    // Mouse/Touch click to flap\n    canvas.addEventListener('mousedown', e => {\n      flap();\n    });\n    canvas.addEventListener('touchstart', e => {\n      e.preventDefault();\n      flap();\n    }, {passive:false});\n\n    function start() {\n      bird.y = 150;\n      bird.velocity = 0;\n      pipes = [];\n      score = 0;\n      scoreLabel.textContent = score;\n      overlay.style.display = 'none';\n      gameRunning = true;\n      frameCount = 0;\n      playTone(400, 0.15);\n      requestAnimationFrame(loop);\n    }\n\n    function spawnPipe() {\n      let gap = 110;\n      let minHeight = 40;\n      let maxHeight = canvas.height - gap - minHeight;\n      let topHeight = Math.floor(Math.random() * (maxHeight - minHeight)) + minHeight;\n      pipes.push({\n        x: canvas.width,\n        topHeight: topHeight,\n        bottomY: topHeight + gap,\n        width: 48,\n        passed: false\n      });\n    }\n\n    function loop() {\n      if (!gameRunning) return;\n      update();\n      draw();\n      requestAnimationFrame(loop);\n    }\n\n    function update() {\n      bird.velocity += bird.gravity;\n      bird.y += bird.velocity;\n\n      // Check falls off / hit ceiling\n      if (bird.y + bird.r > canvas.height) {\n        gameOver();\n        return;\n      }\n      if (bird.y - bird.r < 0) {\n        bird.y = bird.r;\n        bird.velocity = 0.5;\n      }\n\n      // Spawning pipes\n      frameCount++;\n      if (frameCount % pipeSpawnInterval === 0) {\n        spawnPipe();\n      }\n\n      // Move & Collide Pipes\n      pipes.forEach((p, idx) => {\n        p.x -= 2.2; // Speed of scroll\n\n        // Collision Check\n        if (bird.x + bird.r >= p.x && bird.x - bird.r <= p.x + p.width) {\n          if (bird.y - bird.r <= p.topHeight || bird.y + bird.r >= p.bottomY) {\n            gameOver();\n            return;\n          }\n        }\n\n        // Score increment\n        if (!p.passed && p.x + p.width < bird.x) {\n          score++;\n          p.passed = true;\n          scoreLabel.textContent = score;\n          if (score > highScore) {\n            highScore = score;\n            highLabel.textContent = highScore;\n            localStorage.setItem('flappy_high', highScore);\n          }\n          playTone(650, 0.08, 'triangle');\n        }\n\n        // Delete offscreen pipes\n        if (p.x + p.width < 0) {\n          pipes.splice(idx, 1);\n        }\n      });\n    }\n\n    function gameOver() {\n      gameRunning = false;\n      playTone(180, 0.35, 'sawtooth');\n      stateTitle.textContent = \"GAMEOVER\";\n      stateTitle.style.color = \"#ef4444\";\n      actionBtn.textContent = \"TRY AGAIN\";\n      overlay.style.display = 'flex';\n    }\n\n    function draw() {\n      ctx.clearRect(0,0, canvas.width, canvas.height);\n\n      // Ambient stars background\n      ctx.fillStyle = '#1e1b4b';\n      for (let i = 0; i < canvas.width; i += 50) {\n        ctx.fillRect(i + (frameCount % 50), 40, 2, 2);\n        ctx.fillRect((i * 1.5 + (frameCount * 0.5)) % canvas.width, 240, 1, 1);\n      }\n\n      // Draw Pipes\n      pipes.forEach(p => {\n        // Glowing Green-Purple border\n        ctx.fillStyle = '#a855f7';\n        ctx.shadowBlur = 6;\n        ctx.shadowColor = '#a855f7';\n        \n        // Top pipe\n        ctx.fillRect(p.x, 0, p.width, p.topHeight);\n        // Bottom pipe\n        ctx.fillRect(p.x, p.bottomY, p.width, canvas.height - p.bottomY);\n        \n        // Pipe lips\n        ctx.fillStyle = '#d8b4fe';\n        ctx.fillRect(p.x - 3, p.topHeight - 12, p.width + 6, 12);\n        ctx.fillRect(p.x - 3, p.bottomY, p.width + 6, 12);\n      });\n      ctx.shadowBlur = 0;\n\n      // Draw Bird\n      ctx.fillStyle = '#fbbf24';\n      ctx.shadowBlur = 10;\n      ctx.shadowColor = '#fbbf24';\n      ctx.beginPath();\n      ctx.arc(bird.x, bird.y, bird.r, 0, Math.PI*2);\n      ctx.fill();\n      \n      // Draw retro wing shape using rotation approximation\n      ctx.fillStyle = '#f59e0b';\n      ctx.beginPath();\n      ctx.ellipse(bird.x - 4, bird.y + (bird.velocity > 0 ? -1 : 2), 5, 3, (bird.velocity * 0.05), 0, Math.PI*2);\n      ctx.fill();\n      \n      // Draw eye\n      ctx.fillStyle = '#000000';\n      ctx.beginPath();\n      ctx.arc(bird.x + 4, bird.y - 2, 2, 0, Math.PI*2);\n      ctx.fill();\n      ctx.shadowBlur = 0;\n    }\n  </script>\n</body>\n</html>"
}
