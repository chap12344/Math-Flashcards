{
  "id": "pong",
  "title": "Cyber Pong",
  "description": "High-octane tabletop tennis with particle collision trails, customizable difficulty, and local split-screen controls.",
  "category": "Classic",
  "icon": "Gamepad2",
  "useBlankMath": true,
  "iframeUrl": "about:blank",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Cyber Pong</title>\n  <style>\n    body {\n      margin: 0;\n      background: #090d16;\n      color: #10b981;\n      font-family: 'Courier New', Courier, monospace;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      overflow: hidden;\n      user-select: none;\n    }\n    #game-container {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      max-width: 100%;\n    }\n    canvas {\n      background: #020617;\n      border: 3px solid #10b981;\n      box-shadow: 0 0 25px rgba(16, 185, 129, 0.35);\n      border-radius: 8px;\n      max-width: 90vw;\n      max-height: 55vh;\n      aspect-ratio: 1.6;\n    }\n    #ui {\n      display: flex;\n      justify-content: space-between;\n      width: 600px;\n      max-width: 90vw;\n      margin-bottom: 12px;\n      font-size: 20px;\n      font-weight: bold;\n      letter-spacing: 2px;\n    }\n    #menu-screen {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(15, 23, 42, 0.95);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      border-radius: 8px;\n    }\n    .btn {\n      background: #1e293b;\n      border: 2px solid #10b981;\n      color: #10b981;\n      padding: 12px 24px;\n      margin: 8px;\n      font-weight: bold;\n      font-size: 15px;\n      cursor: pointer;\n      border-radius: 6px;\n      font-family: monospace;\n      letter-spacing: 1px;\n      width: 220px;\n    }\n    .btn:active, .btn.selected {\n      background: #10b981;\n      color: #020617;\n    }\n    #mobile-controls {\n      display: flex;\n      justify-content: space-between;\n      width: 90vw;\n      margin-top: 10px;\n    }\n    @media(min-width: 800px) {\n      #mobile-controls { display: none; }\n    }\n    .pad-btn {\n      background: rgba(16, 185, 129, 0.08);\n      border: 2px solid #10b981;\n      color: #10b981;\n      width: 48%;\n      padding: 15px;\n      font-size: 18px;\n      font-weight: bold;\n      border-radius: 6px;\n      text-align: center;\n      cursor: pointer;\n    }\n    .pad-btn:active {\n      background: #10b981;\n      color: #020617;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <div id=\"ui\">\n      <div id=\"p1-score\">PLAYER 1: 0</div>\n      <div id=\"p2-score\">CPU: 0</div>\n    </div>\n    <canvas id=\"game\" width=\"640\" height=\"400\"></canvas>\n    \n    <div id=\"menu-screen\">\n      <h2 style=\"color: #10b981; margin: 0 0 5px 0; font-size: 28px;\">CYBER PONG</h2>\n      <p style=\"color: #64748b; font-size: 11px; margin-bottom: 25px;\">W/S FOR P1, UP/DOWN FOR P2</p>\n      <button class=\"btn\" onclick=\"startGame(false)\">1 PLAYER (VS CPU)</button>\n      <button class=\"btn\" onclick=\"startGame(true)\">2 PLAYER (LOCAL CO-OP)</button>\n    </div>\n\n    <div id=\"mobile-controls\">\n      <button class=\"pad-btn\" id=\"btn-p1-up\" style=\"display:none;\">P1 UP</button>\n      <button class=\"pad-btn\" id=\"btn-p1-down\" style=\"display:none;\">P1 DOWN</button>\n    </div>\n  </div>\n\n  <script>\n    let audioCtx = null;\n    function playTone(freq, duration, type = 'sine') {\n      try {\n        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        if (audioCtx.state === 'suspended') audioCtx.resume();\n        let osc = audioCtx.createOscillator();\n        let gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n        osc.type = type;\n        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n        osc.start();\n        osc.stop(audioCtx.currentTime + duration);\n      } catch(e){}\n    }\n\n    const canvas = document.getElementById('game');\n    const ctx = canvas.getContext('2d');\n    const p1Label = document.getElementById('p1-score');\n    const p2Label = document.getElementById('p2-score');\n    const menuScreen = document.getElementById('menu-screen');\n\n    // Game state\n    let isMultiplayer = false;\n    let gameRunning = false;\n    let pointsLimit = 10;\n    \n    const paddleWidth = 12, paddleHeight = 80;\n    let p1 = { x: 20, y: 160, score: 0 };\n    let p2 = { x: 640 - 20 - 12, y: 160, score: 0 };\n    let ball = { x: 320, y: 200, vx: 0, vy: 0, r: 8, baseSpeed: 5.5, currentSpeed: 5.5 };\n    let particles = [];\n\n    // Keys state\n    let keys = {};\n    window.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });\n    window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\n\n    // Touch buttons support\n    const canvasEl = canvas;\n    canvasEl.addEventListener('touchstart', handleTouch, {passive:false});\n    canvasEl.addEventListener('touchmove', handleTouch, {passive:false});\n\n    function handleTouch(e) {\n      e.preventDefault();\n      const rect = canvas.getBoundingClientRect();\n      for(let t of e.touches) {\n        const touchX = ((t.clientX - rect.left) / rect.width) * canvas.width;\n        const touchY = ((t.clientY - rect.top) / rect.height) * canvas.height;\n        \n        if(touchX < canvas.width / 2) {\n          p1.y = touchY - paddleHeight/2;\n        } else if(isMultiplayer) {\n          p2.y = touchY - paddleHeight/2;\n        }\n      }\n    }\n\n    function startGame(multi) {\n      isMultiplayer = multi;\n      p1.score = 0;\n      p2.score = 0;\n      p1.y = 160;\n      p2.y = 160;\n      p2Label.textContent = isMultiplayer ? \"PLAYER 2: 0\" : \"CPU: 0\";\n      p1Label.textContent = \"PLAYER 1: 0\";\n      menuScreen.style.display = 'none';\n      gameRunning = true;\n      spawnBall();\n      requestAnimationFrame(loop);\n    }\n\n    function spawnBall() {\n      ball.x = canvas.width / 2;\n      ball.y = canvas.height / 2;\n      ball.currentSpeed = ball.baseSpeed;\n      let dir = Math.random() > 0.5 ? 1 : -1;\n      let angle = (Math.random() * 2 - 1) * Math.PI / 4;\n      ball.vx = dir * ball.currentSpeed * Math.cos(angle);\n      ball.vy = ball.currentSpeed * Math.sin(angle);\n      playTone(320, 0.15);\n    }\n\n    function addBounceParticles(x, y, color) {\n      for(let i=0; i<8; i++) {\n        particles.push({\n          x: x,\n          y: y,\n          vx: (Math.random() - 0.5) * 6,\n          vy: (Math.random() - 0.5) * 6,\n          life: 1.0,\n          decay: 0.05 + Math.random() * 0.05,\n          color: color\n        });\n      }\n    }\n\n    function loop() {\n      if(!gameRunning) return;\n      update();\n      draw();\n      requestAnimationFrame(loop);\n    }\n\n    function update() {\n      // Move P1\n      if (keys['w']) p1.y -= 7;\n      if (keys['s']) p1.y += 7;\n      p1.y = Math.max(5, Math.min(canvas.height - paddleHeight - 5, p1.y));\n\n      // Move P2 (CPU or Player 2)\n      if (isMultiplayer) {\n        if (keys['arrowup']) p2.y -= 7;\n        if (keys['arrowdown']) p2.y += 7;\n      } else {\n        // Intelligent responsive CPU with variable tracking\n        let targetY = ball.y - paddleHeight / 2;\n        let diff = targetY - p2.y;\n        let cpuSpeed = 4.2 + (ball.currentSpeed * 0.15); // scales with ball speed\n        p2.y += Math.max(-cpuSpeed, Math.min(cpuSpeed, diff));\n      }\n      p2.y = Math.max(5, Math.min(canvas.height - paddleHeight - 5, p2.y));\n\n      // Move Ball\n      ball.x += ball.vx;\n      ball.y += ball.vy;\n\n      // Wall bounces\n      if (ball.y < ball.r) {\n        ball.y = ball.r;\n        ball.vy = -ball.vy;\n        playTone(400, 0.06, 'triangle');\n      }\n      if (ball.y > canvas.height - ball.r) {\n        ball.y = canvas.height - ball.r;\n        ball.vy = -ball.vy;\n        playTone(400, 0.06, 'triangle');\n      }\n\n      // Particles move\n      particles.forEach((p, idx) => {\n        p.x += p.vx;\n        p.y += p.vy;\n        p.life -= p.decay;\n        if(p.life <= 0) particles.splice(idx, 1);\n      });\n\n      // Paddle Collisions\n      if (ball.vx < 0) {\n        // Left Side Player 1\n        if (ball.x - ball.r <= p1.x + paddleWidth && ball.x + ball.r >= p1.x) {\n          if (ball.y >= p1.y && ball.y <= p1.y + paddleHeight) {\n            ball.x = p1.x + paddleWidth + ball.r;\n            ball.currentSpeed += 0.4;\n            let relativeY = (ball.y - (p1.y + paddleHeight/2)) / (paddleHeight/2);\n            let bounceAngle = relativeY * Math.PI/3;\n            ball.vx = ball.currentSpeed * Math.cos(bounceAngle);\n            ball.vy = ball.currentSpeed * Math.sin(bounceAngle);\n            playTone(480, 0.08, 'square');\n            addBounceParticles(ball.x, ball.y, '#10b981');\n          }\n        }\n      } else {\n        // Right Side Player 2/CPU\n        if (ball.x + ball.r >= p2.x && ball.x - ball.r <= p2.x + paddleWidth) {\n          if (ball.y >= p2.y && ball.y <= p2.y + paddleHeight) {\n            ball.x = p2.x - ball.r;\n            ball.currentSpeed += 0.4;\n            let relativeY = (ball.y - (p2.y + paddleHeight/2)) / (paddleHeight/2);\n            let bounceAngle = relativeY * Math.PI/3;\n            ball.vx = -ball.currentSpeed * Math.cos(bounceAngle);\n            ball.vy = ball.currentSpeed * Math.sin(bounceAngle);\n            playTone(480, 0.08, 'square');\n            addBounceParticles(ball.x, ball.y, '#10b981');\n          }\n        }\n      }\n\n      // Scoring\n      if (ball.x < 0) {\n        p2.score++;\n        p2Label.textContent = (isMultiplayer ? \"PLAYER 2: \" : \"CPU: \") + p2.score;\n        playTone(180, 0.3, 'sawtooth');\n        checkGameOver();\n      }\n      if (ball.x > canvas.width) {\n        p1.score++;\n        p1Label.textContent = \"PLAYER 1: \" + p1.score;\n        playTone(600, 0.3, 'sawtooth');\n        checkGameOver();\n      }\n    }\n\n    function checkGameOver() {\n      if(p1.score >= pointsLimit || p2.score >= pointsLimit) {\n        gameRunning = false;\n        menuScreen.style.display = 'flex';\n        let winnerText = document.querySelector('#menu-screen h2');\n        if(p1.score >= pointsLimit) {\n          winnerText.textContent = \"PLAYER 1 WINS!\";\n          winnerText.style.color = \"#10b981\";\n        } else {\n          winnerText.textContent = isMultiplayer ? \"PLAYER 2 WINS!\" : \"CPU WINS!\";\n          winnerText.style.color = \"#ef4444\";\n        }\n      } else {\n        spawnBall();\n      }\n    }\n\n    function draw() {\n      ctx.clearRect(0,0, canvas.width, canvas.height);\n\n      // Grid lines\n      ctx.strokeStyle = 'rgba(16, 185, 129, 0.04)';\n      ctx.lineWidth = 1;\n      for(let x=0; x<canvas.width; x+=40) {\n        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();\n      }\n\n      // Center line dashes\n      ctx.strokeStyle = 'rgba(16, 185, 129, 0.3)';\n      ctx.lineWidth = 4;\n      ctx.setLineDash([15, 15]);\n      ctx.beginPath();\n      ctx.moveTo(canvas.width/2, 0);\n      ctx.lineTo(canvas.width/2, canvas.height);\n      ctx.stroke();\n      ctx.setLineDash([]);\n\n      // Draw paddles\n      ctx.fillStyle = '#10b981';\n      ctx.shadowBlur = 10;\n      ctx.shadowColor = '#10b981';\n      ctx.fillRect(p1.x, p1.y, paddleWidth, paddleHeight);\n      ctx.fillRect(p2.x, p2.y, paddleWidth, paddleHeight);\n\n      // Draw particles\n      particles.forEach(p => {\n        ctx.fillStyle = p.color;\n        ctx.globalAlpha = p.life;\n        ctx.fillRect(p.x, p.y, 4, 4);\n      });\n      ctx.globalAlpha = 1.0;\n\n      // Draw Ball\n      ctx.fillStyle = '#ffffff';\n      ctx.shadowBlur = 12;\n      ctx.shadowColor = '#ffffff';\n      ctx.beginPath();\n      ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.shadowBlur = 0;\n    }\n  </script>\n</body>\n</html>"
}
