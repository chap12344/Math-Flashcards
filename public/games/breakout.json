{
  "id": "breakout",
  "title": "Brick Breaker",
  "description": "Smash layers of retro blocks using bouncy energy power-ups, paddle modifications, and multi-ball triggers.",
  "category": "Arcade",
  "icon": "Box",
  "useBlankMath": true,
  "iframeUrl": "about:blank",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Brick Breaker</title>\n  <style>\n    body {\n      margin: 0;\n      background: #090d16;\n      color: #ec4899;\n      font-family: 'Courier New', Courier, monospace;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      overflow: hidden;\n      user-select: none;\n    }\n    #game-container {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      max-width: 100%;\n    }\n    canvas {\n      background: #020617;\n      border: 3px solid #ec4899;\n      box-shadow: 0 0 25px rgba(236, 72, 153, 0.35);\n      border-radius: 8px;\n      max-width: 90vw;\n      max-height: 55vh;\n      aspect-ratio: 1.25;\n    }\n    #ui {\n      display: flex;\n      justify-content: space-between;\n      width: 500px;\n      max-width: 90vw;\n      margin-bottom: 12px;\n      font-size: 16px;\n      font-weight: bold;\n      letter-spacing: 1px;\n    }\n    #overlay {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(15, 23, 42, 0.95);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      border-radius: 8px;\n      text-align: center;\n    }\n    .btn {\n      background: #1e293b;\n      border: 2px solid #ec4899;\n      color: #ec4899;\n      padding: 12px 28px;\n      font-weight: bold;\n      font-size: 16px;\n      cursor: pointer;\n      border-radius: 6px;\n      font-family: monospace;\n      letter-spacing: 2px;\n      margin-top: 15px;\n      transition: transform 0.1s;\n    }\n    .btn:active {\n      transform: scale(0.95);\n    }\n    #info-text {\n      color: #64748b;\n      font-size: 11px;\n      margin: 5px 0 20px 0;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <div id=\"ui\">\n      <div>SCORE: <span id=\"score\">0</span></div>\n      <div>LEVEL: <span id=\"level-val\">1</span></div>\n      <div>LIVES: <span id=\"lives\">3</span></div>\n    </div>\n    <canvas id=\"game\" width=\"500\" height=\"400\"></canvas>\n    \n    <div id=\"overlay\">\n      <h2 id=\"state-title\" style=\"color: #ec4899; margin: 0; font-size: 28px;\">BRICK BREAKER</h2>\n      <p id=\"info-text\">USE MOUSE, TOUCH, OR LEFT/RIGHT ARROWS TO MOVE PADDLE</p>\n      <button class=\"btn\" id=\"action-btn\" onclick=\"start()\">START GAME</button>\n    </div>\n  </div>\n\n  <script>\n    let audioCtx = null;\n    function playTone(freq, duration, type = 'sine') {\n      try {\n        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        if (audioCtx.state === 'suspended') audioCtx.resume();\n        let osc = audioCtx.createOscillator();\n        let gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n        osc.type = type;\n        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n        osc.start();\n        osc.stop(audioCtx.currentTime + duration);\n      } catch(e){}\n    }\n\n    const canvas = document.getElementById('game');\n    const ctx = canvas.getContext('2d');\n    const scoreLabel = document.getElementById('score');\n    const livesLabel = document.getElementById('lives');\n    const levelLabel = document.getElementById('level-val');\n    const overlay = document.getElementById('overlay');\n    const stateTitle = document.getElementById('state-title');\n    const actionBtn = document.getElementById('action-btn');\n\n    // Config\n    let score = 0;\n    let lives = 3;\n    let currentLevel = 1;\n    let isPlaying = false;\n\n    let paddle = { x: 200, y: 375, height: 12, width: 90, baseWidth: 90 };\n    let ballList = [];\n    let bricks = [];\n    let particles = [];\n    let powerups = [];\n\n    const rowCount = 5;\n    const columnCount = 8;\n    const brickWidth = 52;\n    const brickHeight = 18;\n    const brickPadding = 6;\n    const brickOffsetTop = 40;\n    const brickOffsetLeft = 20;\n\n    const brickColors = ['#f43f5e', '#ef4444', '#f97316', '#eab308', '#22c55e'];\n\n    // Inputs\n    let keys = {};\n    window.addEventListener('keydown', e => { keys[e.key] = true; });\n    window.addEventListener('keyup', e => { keys[e.key] = false; });\n\n    // Mouse/Touch controls\n    canvas.addEventListener('mousemove', e => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = ((e.clientX - rect.left) / rect.width) * canvas.width;\n      paddle.x = mx - paddle.width / 2;\n      keepPaddleInScreen();\n    });\n    canvas.addEventListener('touchmove', e => {\n      e.preventDefault();\n      const rect = canvas.getBoundingClientRect();\n      const touch = e.touches[0];\n      const tx = ((touch.clientX - rect.left) / rect.width) * canvas.width;\n      paddle.x = tx - paddle.width / 2;\n      keepPaddleInScreen();\n    }, {passive:false});\n\n    function keepPaddleInScreen() {\n      paddle.x = Math.max(2, Math.min(canvas.width - paddle.width - 2, paddle.x));\n    }\n\n    function generateLevel(lvl) {\n      bricks = [];\n      powerups = [];\n      paddle.width = paddle.baseWidth;\n      \n      for (let c = 0; c < columnCount; c++) {\n        bricks[c] = [];\n        for (let r = 0; r < rowCount; r++) {\n          // Level design logic\n          let active = true;\n          if (lvl === 2) { // Column tunnels\n            if (c % 2 === 0 && r % 2 === 0) active = false;\n          } else if (lvl === 3) { // Smiley/Checker pattern\n            if ((c + r) % 2 === 1) active = false;\n          }\n          \n          bricks[c][r] = {\n            x: c * (brickWidth + brickPadding) + brickOffsetLeft,\n            y: r * (brickHeight + brickPadding) + brickOffsetTop,\n            status: active ? 1 : 0,\n            points: (rowCount - r) * 10,\n            color: brickColors[r % brickColors.length]\n          };\n        }\n      }\n    }\n\n    function start() {\n      score = 0;\n      lives = 3;\n      currentLevel = 1;\n      scoreLabel.textContent = score;\n      livesLabel.textContent = lives;\n      levelLabel.textContent = currentLevel;\n      overlay.style.display = 'none';\n      \n      generateLevel(currentLevel);\n      resetBall();\n      isPlaying = true;\n      \n      requestAnimationFrame(loop);\n    }\n\n    function resetBall() {\n      ballList = [{\n        x: canvas.width / 2,\n        y: paddle.y - 12,\n        vx: (Math.random() - 0.5) * 4,\n        vy: -4,\n        r: 7\n      }];\n    }\n\n    function emitParticles(x, y, color) {\n      for(let i=0; i<6; i++) {\n        particles.push({\n          x: x, y: y,\n          vx: (Math.random() - 0.5) * 5,\n          vy: (Math.random() - 0.5) * 5,\n          life: 1.0,\n          decay: 0.05,\n          color: color\n        });\n      }\n    }\n\n    function loop() {\n      if (!isPlaying) return;\n      update();\n      draw();\n      requestAnimationFrame(loop);\n    }\n\n    function update() {\n      // Keyboard moves\n      if (keys['ArrowLeft']) paddle.x -= 6;\n      if (keys['ArrowRight']) paddle.x += 6;\n      keepPaddleInScreen();\n\n      // Move balls\n      ballList.forEach((b, bIdx) => {\n        b.x += b.vx;\n        b.y += b.vy;\n\n        // Side wall bounce\n        if (b.x < b.r || b.x > canvas.width - b.r) {\n          b.vx = -b.vx;\n          playTone(300, 0.05, 'triangle');\n        }\n        // Top bounce\n        if (b.y < b.r) {\n          b.vy = -b.vy;\n          playTone(300, 0.05, 'triangle');\n        }\n\n        // Paddle hit\n        if (b.y + b.r >= paddle.y && b.y - b.r <= paddle.y + paddle.height) {\n          if (b.x >= paddle.x && b.x <= paddle.x + paddle.width) {\n            let diff = b.x - (paddle.x + paddle.width / 2);\n            b.vx = (diff / (paddle.width / 2)) * 4;\n            b.vy = -Math.abs(b.vy); // secure upward bounce\n            playTone(450, 0.08, 'square');\n          }\n        }\n\n        // Brick collision\n        for (let c = 0; c < columnCount; c++) {\n          for (let r = 0; r < rowCount; r++) {\n            let brick = bricks[c][r];\n            if (brick && brick.status === 1) {\n              if (b.x + b.r >= brick.x && b.x - b.r <= brick.x + brickWidth &&\n                  b.y + b.r >= brick.y && b.y - b.r <= brick.y + brickHeight) {\n                \n                brick.status = 0;\n                b.vy = -b.vy;\n                score += brick.points;\n                scoreLabel.textContent = score;\n                emitParticles(brick.x + brickWidth/2, brick.y + brickHeight/2, brick.color);\n                playTone(550, 0.06, 'sine');\n\n                // Powerup spawning\n                if (Math.random() < 0.25) {\n                  const types = ['WIDE', 'MULTIBALL', 'CRAZY'];\n                  powerups.push({\n                    x: brick.x + brickWidth/2,\n                    y: brick.y + brickHeight,\n                    vy: 2,\n                    type: types[Math.floor(Math.random() * types.length)]\n                  });\n                }\n                checkWin();\n                break;\n              }\n            }\n          }\n        }\n\n        // Ball falls off\n        if (b.y > canvas.height) {\n          ballList.splice(bIdx, 1);\n        }\n      });\n\n      // If no balls remaining\n      if (ballList.length === 0) {\n        lives--;\n        livesLabel.textContent = lives;\n        playTone(200, 0.35, 'sawtooth');\n        if (lives <= 0) {\n          gameOver();\n        } else {\n          resetBall();\n        }\n      }\n\n      // Powerups logic\n      powerups.forEach((pu, idx) => {\n        pu.y += pu.vy;\n        // Paddle match\n        if (pu.y >= paddle.y && pu.y <= paddle.y + paddle.height &&\n            pu.x >= paddle.x && pu.x <= paddle.x + paddle.width) {\n          \n          playTone(600, 0.15, 'sine');\n          applyPower(pu.type, pu.x, pu.y);\n          powerups.splice(idx, 1);\n        }\n        if (pu.y > canvas.height) powerups.splice(idx, 1);\n      });\n\n      // Particles move\n      particles.forEach((p, idx) => {\n        p.x += p.vx;\n        p.y += p.vy;\n        p.life -= p.decay;\n        if (p.life <= 0) particles.splice(idx, 1);\n      });\n    }\n\n    function applyPower(type, x, y) {\n      if (type === 'WIDE') {\n        paddle.width = Math.min(180, paddle.width + 30);\n      } else if (type === 'MULTIBALL') {\n        ballList.push({\n          x: x,\n          y: paddle.y - 12,\n          vx: -3,\n          vy: -3.5,\n          r: 7\n        });\n        ballList.push({\n          x: x,\n          y: paddle.y - 12,\n          vx: 3,\n          vy: -3.5,\n          r: 7\n        });\n      } else if (type === 'CRAZY') {\n        score += 50;\n        scoreLabel.textContent = score;\n        emitParticles(paddle.x + paddle.width/2, paddle.y, '#eab308');\n      }\n    }\n\n    function checkWin() {\n      let anyBricks = false;\n      for (let c = 0; c < columnCount; c++) {\n        for (let r = 0; r < rowCount; r++) {\n          if (bricks[c][r].status === 1) anyBricks = true;\n        }\n      }\n\n      if (!anyBricks) {\n        currentLevel++;\n        if (currentLevel > 3) {\n          stateTitle.textContent = \"VICTORY!\";\n          stateTitle.style.color = \"#10b981\";\n          actionBtn.textContent = \"RESET RUN\";\n          overlay.style.display = 'flex';\n          isPlaying = false;\n          playTone(800, 0.4, 'sine');\n        } else {\n          levelLabel.textContent = currentLevel;\n          generateLevel(currentLevel);\n          resetBall();\n          playTone(700, 0.12, 'sine');\n        }\n      }\n    }\n\n    function gameOver() {\n      isPlaying = false;\n      stateTitle.textContent = \"GAME OVER\";\n      stateTitle.style.color = \"#f43f5e\";\n      actionBtn.textContent = \"PLAY AGAIN\";\n      overlay.style.display = 'flex';\n    }\n\n    function draw() {\n      ctx.clearRect(0,0, canvas.width, canvas.height);\n\n      // Ambient grids\n      ctx.strokeStyle = '#111827';\n      ctx.lineWidth = 1;\n      for(let x=0; x<canvas.width; x+=30) {\n        ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x, canvas.height); ctx.stroke();\n      }\n\n      // Draw Bricks\n      for (let c = 0; c < columnCount; c++) {\n        for (let r = 0; r < rowCount; r++) {\n          let b = bricks[c][r];\n          if (b && b.status === 1) {\n            ctx.fillStyle = b.color;\n            ctx.shadowBlur = 4;\n            ctx.shadowColor = b.color;\n            ctx.fillRect(b.x, b.y, brickWidth, brickHeight);\n            \n            // brick specular glints\n            ctx.fillStyle = 'rgba(255,255,255,0.2)';\n            ctx.fillRect(b.x, b.y, brickWidth, 3);\n            ctx.fillRect(b.x, b.y, 4, brickHeight);\n          }\n        }\n      }\n      ctx.shadowBlur = 0;\n\n      // Paddle drawing\n      ctx.fillStyle = '#ec4899';\n      ctx.shadowBlur = 10;\n      ctx.shadowColor = '#ec4899';\n      ctx.fillRect(paddle.x, paddle.y, paddle.width, paddle.height);\n      ctx.shadowBlur = 0;\n\n      // Powerups\n      powerups.forEach(pu => {\n        ctx.fillStyle = pu.type === 'WIDE' ? '#38bdf8' : pu.type === 'MULTIBALL' ? '#a855f7' : '#eab308';\n        ctx.shadowBlur = 8;\n        ctx.shadowColor = ctx.fillStyle;\n        ctx.beginPath();\n        ctx.arc(pu.x, pu.y, 6, 0, Math.PI * 2);\n        ctx.fill();\n      });\n      ctx.shadowBlur = 0;\n\n      // Draw particles\n      particles.forEach(p => {\n        ctx.fillStyle = p.color;\n        ctx.globalAlpha = p.life;\n        ctx.fillRect(p.x, p.y, 4, 4);\n      });\n      ctx.globalAlpha = 1.0;\n\n      // Draw balls\n      ballList.forEach(b => {\n        ctx.fillStyle = '#ffffff';\n        ctx.shadowBlur = 8;\n        ctx.shadowColor = '#ffffff';\n        ctx.beginPath();\n        ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);\n        ctx.fill();\n      });\n      ctx.shadowBlur = 0;\n    }\n  </script>\n</body>\n</html>"
}
