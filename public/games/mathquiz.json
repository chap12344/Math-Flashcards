{
  "id": "mathquiz",
  "title": "Speed Math Challenge",
  "description": "Test your reflexes and basic operations under a ticking retro timer. Perfect for pretending to be studying!",
  "category": "Math",
  "icon": "Calculator",
  "useBlankMath": true,
  "iframeUrl": "about:blank",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Speed Math Challenge</title>\n  <style>\n    body {\n      margin: 0;\n      background: #090d16;\n      color: #3b82f6;\n      font-family: 'Courier New', Courier, monospace;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      overflow: hidden;\n      user-select: none;\n    }\n    #game-container {\n      width: 420px;\n      max-width: 90vw;\n      background: #0f172a;\n      border: 3px solid #3b82f6;\n      box-shadow: 0 0 25px rgba(59, 130, 246, 0.3);\n      border-radius: 12px;\n      padding: 20px;\n      box-sizing: border-box;\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    #timer-bar-container {\n      width: 100%;\n      height: 10px;\n      background: #1e293b;\n      border-radius: 5px;\n      overflow: hidden;\n      margin-bottom: 20px;\n    }\n    #timer-bar {\n      width: 100%;\n      height: 100%;\n      background: #3b82f6;\n      transition: width 0.1s linear;\n    }\n    #stats {\n      display: flex;\n      justify-content: space-between;\n      width: 100%;\n      font-size: 16px;\n      font-weight: bold;\n      margin-bottom: 15px;\n    }\n    #equation {\n      font-size: 42px;\n      font-weight: bold;\n      margin: 25px 0;\n      color: #ffffff;\n      text-shadow: 0 0 10px rgba(255,255,255,0.2);\n    }\n    .options-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n      width: 100%;\n    }\n    .option-btn {\n      background: #1e293b;\n      border: 2px solid #3b82f6;\n      color: #3b82f6;\n      font-family: monospace;\n      font-size: 20px;\n      font-weight: bold;\n      padding: 15px;\n      border-radius: 8px;\n      cursor: pointer;\n      transition: background 0.1s, transform 0.05s;\n    }\n    .option-btn:active {\n      transform: scale(0.97);\n    }\n    .option-btn.correct {\n      background: #10b981; \n      border-color: #10b981;\n      color: #020617;\n    }\n    .option-btn.wrong {\n      background: #ef4444; \n      border-color: #ef4444;\n      color: #020617;\n    }\n    #overlay {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(15, 23, 42, 0.96);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      border-radius: 12px;\n      text-align: center;\n      padding: 20px;\n      box-sizing: border-box;\n    }\n    .btn {\n      background: #3b82f6;\n      color: #020617;\n      border: none;\n      padding: 12px 30px;\n      font-weight: bold;\n      font-size: 16px;\n      cursor: pointer;\n      border-radius: 6px;\n      font-family: monospace;\n      letter-spacing: 2px;\n      margin-top: 20px;\n    }\n    #modes-select {\n      margin-top: 15px;\n      display: flex;\n      gap: 8px;\n    }\n    .mode-choice {\n      background: #1e293b;\n      color: #64748b;\n      border: 1px solid #334155;\n      padding: 6px 12px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 11px;\n    }\n    .mode-choice.active {\n      border-color: #3b82f6;\n      color: #3b82f6;\n      background: rgba(59, 130, 246, 0.1);\n    }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <div id=\"timer-bar-container\">\n      <div id=\"timer-bar\"></div>\n    </div>\n    <div id=\"stats\">\n      <div>SCORE: <span id=\"score\">0</span></div>\n      <div>STREAK: <span id=\"streak\">0</span>🔥</div>\n    </div>\n    \n    <div id=\"equation\">9 + 5</div>\n    \n    <div class=\"options-grid\">\n      <button class=\"option-btn\" onclick=\"answer(0)\" id=\"opt0\">14</button>\n      <button class=\"option-btn\" onclick=\"answer(1)\" id=\"opt1\">12</button>\n      <button class=\"option-btn\" onclick=\"answer(2)\" id=\"opt2\">15</button>\n      <button class=\"option-btn\" onclick=\"answer(3)\" id=\"opt3\">10</button>\n    </div>\n\n    <div id=\"overlay\">\n      <h2 style=\"color: #3b82f6; margin: 0 0 10px 0; font-size: 26px;\">SPEED MATH</h2>\n      <p style=\"color: #64748b; font-size: 11px; margin: 0 0 10px 0; max-width: 80%;\">TAP THE CORRECT ANSWER BEFORE THE TIME EXPIRES. INCREASES IN DIFFICULTY!</p>\n      <div id=\"modes-select\">\n        <button class=\"mode-choice active\" onclick=\"setOp('+')\" id=\"op-add\">ADD/SUB</button>\n        <button class=\"mode-choice\" onclick=\"setOp('*')\" id=\"op-mul\">MULTIPLICATION</button>\n        <button class=\"mode-choice\" onclick=\"setOp('both')\" id=\"op-both\">ALL MIXED</button>\n      </div>\n      <button class=\"btn\" onclick=\"playGame()\">START MATHS</button>\n    </div>\n  </div>\n\n  <script>\n    let audioCtx = null;\n    function playTone(freq, duration, type = 'sine') {\n      try {\n        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        if (audioCtx.state === 'suspended') audioCtx.resume();\n        let osc = audioCtx.createOscillator();\n        let gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n        osc.type = type;\n        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n        osc.start();\n        osc.stop(audioCtx.currentTime + duration);\n      } catch(e){}\n    }\n\n    const overlay = document.getElementById('overlay');\n    const equationText = document.getElementById('equation');\n    const scoreLabel = document.getElementById('score');\n    const streakLabel = document.getElementById('streak');\n    const timerBar = document.getElementById('timer-bar');\n    const optButtons = [0,1,2,3].map(i => document.getElementById('opt' + i));\n\n    let score = 0;\n    let streak = 0;\n    let operationType = '+';\n    let currentAnswer = 0;\n    let timeLimit = 5000; // ms\n    let timeLeft = 5000;\n    let gameInterval = null;\n    let tickRate = 50;\n    let canClick = false;\n\n    function setOp(type) {\n      operationType = type;\n      document.querySelectorAll('.mode-choice').forEach(b => b.classList.remove('active'));\n      if(type === '+') document.getElementById('op-add').classList.add('active');\n      if(type === '*') document.getElementById('op-mul').classList.add('active');\n      if(type === 'both') document.getElementById('op-both').classList.add('active');\n      playTone(400, 0.05, 'triangle');\n    }\n\n    function playGame() {\n      score = 0;\n      streak = 0;\n      scoreLabel.textContent = score;\n      streakLabel.textContent = streak;\n      overlay.style.display = 'none';\n      playTone(480, 0.1, 'sine');\n      generateQuestion();\n    }\n\n    function generateQuestion() {\n      canClick = true;\n      optButtons.forEach(b => { b.className = 'option-btn'; });\n      \n      let num1, num2, opKeyword, eqDisplay;\n      \n      let selectOp = operationType;\n      if(operationType === 'both') {\n        selectOp = Math.random() > 0.4 ? '+' : '*';\n      }\n\n      // scale numbers with score\n      let scoreFactor = Math.floor(score / 50);\n      \n      if (selectOp === '+') {\n        let subtract = Math.random() > 0.5;\n        if(subtract) {\n          num1 = Math.floor(Math.random() * (12 + scoreFactor * 5)) + 8;\n          num2 = Math.floor(Math.random() * num1);\n          currentAnswer = num1 - num2;\n          eqDisplay = num1 + ' - ' + num2;\n        } else {\n          num1 = Math.floor(Math.random() * (15 + scoreFactor * 6)) + 2;\n          num2 = Math.floor(Math.random() * (15 + scoreFactor * 6)) + 2;\n          currentAnswer = num1 + num2;\n          eqDisplay = num1 + ' + ' + num2;\n        }\n      } else {\n        num1 = Math.floor(Math.random() * (8 + scoreFactor)) + 2;\n        num2 = Math.floor(Math.random() * (9 + scoreFactor)) + 2;\n        currentAnswer = num1 * num2;\n        eqDisplay = num1 + ' × ' + num2;\n      }\n\n      equationText.textContent = eqDisplay;\n      \n      // create option set\n      let choices = [currentAnswer];\n      while(choices.length < 4) {\n        let offset = Math.floor(Math.random() * 10) - 5;\n        if(Math.random() > 0.7) offset = Math.floor(Math.random() * 30) - 15;\n        let wrong = currentAnswer + offset;\n        if(wrong > 0 && !choices.includes(wrong) && wrong !== currentAnswer) {\n          choices.push(wrong);\n        }\n      }\n      \n      // Shuffle choices\n      choices.sort(() => Math.random() - 0.5);\n      \n      for (let i = 0; i < 4; i++) {\n        optButtons[i].textContent = choices[i];\n      }\n\n      // Reset timer\n      timeLimit = Math.max(1800, 5000 - (score * 25)); // ramps up speed\n      timeLeft = timeLimit;\n      \n      if(gameInterval) clearInterval(gameInterval);\n      gameInterval = setInterval(tick, tickRate);\n    }\n\n    function tick() {\n      timeLeft -= tickRate;\n      if(timeLeft <= 0) {\n        timeLeft = 0;\n        clearInterval(gameInterval);\n        gameOver('TIME EXPIRED!');\n      }\n      let percent = (timeLeft / timeLimit) * 100;\n      timerBar.style.width = percent + '%';\n    }\n\n    function answer(index) {\n      if (!canClick) return;\n      canClick = false;\n      clearInterval(gameInterval);\n      \n      let selectedVal = parseInt(optButtons[index].textContent);\n      if (selectedVal === currentAnswer) {\n        optButtons[index].classList.add('correct');\n        score += 10 + Math.min(10, streak);\n        streak++;\n        scoreLabel.textContent = score;\n        streakLabel.textContent = streak;\n        playTone(650, 0.08, 'sine');\n        setTimeout(generateQuestion, 500);\n      } else {\n        optButtons[index].classList.add('wrong');\n        // highlight correct one\n        optButtons.forEach(b => {\n          if(parseInt(b.textContent) === currentAnswer) b.classList.add('correct');\n        });\n        playTone(200, 0.3, 'sawtooth');\n        setTimeout(() => { gameOver('INCORRECT ANSWER!'); }, 600);\n      }\n    }\n\n    function gameOver(reason) {\n      canClick = false;\n      clearInterval(gameInterval);\n      overlay.style.display = 'flex';\n      document.querySelector('#overlay h2').textContent = \"GAME OVER\";\n      document.querySelector('#overlay h2').style.color = \"#ef4444\";\n      document.getElementById('info-text').textContent = reason + \" | Streak: \" + streak + \" | Total score: \" + score;\n      document.querySelector('.btn').textContent = \"TRY AGAIN\";\n    }\n  </script>\n</body>\n</html>"
}
